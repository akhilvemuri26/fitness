APP_NAME=AkhilFit
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_BASE_URL=http://127.0.0.1:8000
CANONICAL_TIMEZONE=America/Indiana/Indianapolis

# Local development defaults to SQLite. Hosted deployments should use Neon Postgres.
DATABASE_URL=sqlite:///./fitness.db

# Enable the in-process scheduler locally. Disable this on hosted Koyeb deployments.
ENABLE_SCHEDULER=true
INTERNAL_SYNC_TOKEN=change-me
DEFAULT_BACKFILL_DAYS=90
ENABLE_WHOOP_WEBHOOKS=false

WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://127.0.0.1:8000/connect/whoop/callback
WHOOP_WEBHOOK_SECRET=

HEVY_API_KEY=

MFP_BRIDGE_SHARED_TOKEN=change-me
MFP_COOKIE_HEADER=
MFP_COOKIE_FILE=
MFP_BRIDGE_BASE_URL=http://127.0.0.1:8000
MFP_BACKFILL_DAYS=90
MFP_SYNC_WINDOW_DAYS=3
